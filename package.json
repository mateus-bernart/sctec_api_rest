{
  "name": "tecsc-api-rest",
  "version": "1.0.0",
  "description": "Projeto para desenvolver API REST para empreendimentos.",
  "main": "index.js",
  "scripts": {
    "dev": "trap \"npm run services:down\" INT EXIT && npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand'",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/database/compose.yaml up -d",
    "services:down": "docker compose -f infra/database/compose.yaml down",
    "services:stop": "docker compose -f infra/database/compose.yaml stop",
    "migrations:create": "node-pg-migrate -m infra/database/migrations create",
    "migrations:up": "node-pg-migrate -m infra/database/migrations --envPath .env.development up",
    "services:wait:database": "node ./infra/database/wait-for-postgres.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/jest": "29.5.14",
    "async-retry": "1.3.3",
    "concurrently": "9.2.1",
    "dotenv": "16.4.5",
    "dotenv-expand": "11.0.6",
    "jest": "29.7.0",
    "next": "14.2.5",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "pg": "8.12.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "9.7.0"
  }
}
